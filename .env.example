# Scout Bot - Environment Example
# Copy to .env and fill values: cp .env.example .env

# Bot identity (BOT_ID selects proxy via data/routing.json, BOT_EMAIL overrides)
BOT_ID=0
# BOT_EMAIL=junchun@cultinet.site  # optional override

# Site
SITE_DOMAIN=scoutandrunner.com
DEBUGGER_PORT=9222
BOT_MODE=2
POLL_INTERVAL=1.0
HUMAN_LIKE_MODE=true
API_PAIRING=true

# Gmail IMAP App Password (primary OTP method)
# Generate at https://myaccount.google.com/apppasswords (requires 2FA)
# For faxcheck2@gmail.com - all Cloudflare forwards route here, single password suffices.
# Remove spaces from displayed password, e.g. "qece wuff aqbc bdjf" => "qecewuffaqbcbdjf"
GMAIL_FAXCHECK2_APP_PASSWORD=your_app_password_no_spaces
# Generic fallback (also checked):
# GMAIL_APP_PASSWORD=your_app_password_no_spaces
# Per-inbox override example (for direct gmail proxies if needed):
# GMAIL_VETTYCHECKY_APP_PASSWORD=...
# GMAIL_NETTYCHECKY_APP_PASSWORD=...

# Optional: path override for password file (otherwise data/gmail_app_password.txt)
# GMAIL_APP_PASSWORD_FILE=data/gmail_app_password.txt

# Comms server - Railway bot -> Render Postgres server
# Set on Railway dashboard: Variables -> SERVER_URL
SERVER_URL=https://scout-server-nm2m.onrender.com/api
BOT_TOKEN=scout-secret
# Legacy alt names (also read by bot.py if SERVER_URL unset):
# XAMPP_SERVER_URL=https://scout-server-nm2m.onrender.com/api
# SCOUT_SERVER_URL=https://scout-server-nm2m.onrender.com/api

# License selection
# LICENSE_ID=

# Auth API (if needed)
# AUTH_API_KEY=sb_publishable_yKqi0fu5vV6G4ryUIMJuzw_NCoFEl1c

# Legacy OAuth fallback (if still using Gmail API):
# data/gmail_credentials.json + data/gmail_token.json
# Kept for compatibility but IMAP is primary.
